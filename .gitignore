/.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/

# ------------------------------------------------------------------------------
# 2. DERLEME VE GEÇİCİ ÇIKTILAR (Build & Temporary Outputs)
# ------------------------------------------------------------------------------
.next/
out/
build/
dist/
.output/
.turbo/
*.tsbuildinfo
next-env.d.ts.bak

# ------------------------------------------------------------------------------
# 3. GİZLİ VERİLER, ÇEVRE DEĞİŞKENLERİ VE SIRLAR (Security & Secrets)
# ASLA commit edilmeyecek sırlar, veritabanı bağlantıları, API anahtarları
# ------------------------------------------------------------------------------
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
.env.staging
.env.production
*.pem
*.key
*.cert
*.crt
id_rsa
id_ecdsa
id_ed25519
*.pfx
*.p12

# ------------------------------------------------------------------------------
# 4. GÜNLÜK DOSYALARI (Logs)
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. TEST, KAPSAM VE ÇALIŞMA RAPORLARI (Testing & Coverage)
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
.clinic/
playwright-report/
test-results/

# ------------------------------------------------------------------------------
# 6. EDİTÖR, İŞLETİM SİSTEMİ VE YEREL GELİŞTİRİCİ ARTIKLARI
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editör
