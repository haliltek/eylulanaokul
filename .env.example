# Sunucu Portu (142.93.104.78 üzerinde Sigortam Dijital 8088 yanında tahsis edilen Port 8089)
APP_PORT=8089

# Ortam Bilgisi
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Uygulama URL ve Güvenlik
NEXT_PUBLIC_APP_URL=http://142.93.104.78:8089
NEXTAUTH_SECRET=anaokulu_secure_jwt_random_secret_change_in_production
NEXTAUTH_URL=http://142.93.104.78:8089

# Depolama Yolları
UPLOADS_DIR=./uploads
DATA_DIR=./data
UNLIGHTHOUSE_DIR=./public/unlighthouse
